# Neon connection string (Neon console -> your project -> Connection Details).
# Use the "pooled" connection string.
DATABASE_URL=postgres://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Any long random string, used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# PayMongo dashboard -> Developers -> API Keys. Use the *secret* key (starts with sk_test_ / sk_live_).
# Start with the sk_test_ key -- test mode works without the DTI/BIR business activation.
PAYMONGO_SECRET_KEY=sk_test_replace-me

# PayMongo dashboard -> Developers -> Webhooks -> (create one pointing at
# https://<your-site>/.netlify/functions/paymongo-webhook) -> the signing secret it shows you.
PAYMONGO_WEBHOOK_SECRET=whsk_replace-me

# The portal's own public URL, used to build PayMongo's success/cancel redirect links.
PORTAL_URL=https://portal.clmits.com

# Gmail address used to send welcome/credential emails, plus a Google App
# Password (requires 2FA on the account) -- generate one at
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=replace-with-a-16-char-app-password
GMAIL_FROM_NAME=CL Magno I.T. Solutions

# Google Cloud Console -> OAuth 2.0 Client (Web application) for the Calendar
# API. The OAuth consent screen MUST be set to "Production" publishing status
# -- leaving it in "Testing" causes refresh tokens to silently expire after 7
# days. Redirect URI must exactly match what's registered in the console.
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://portal.clmits.com/.netlify/functions/admin-google-auth-callback
